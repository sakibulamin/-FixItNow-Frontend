# Base URL of the FixItNow backend API (confirmed from Postman collection: localhost:5000/api)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Public URL this frontend is deployed at (used for metadata/Open Graph tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Name of the cookie used to store the JWT access token
NEXT_PUBLIC_AUTH_TOKEN_COOKIE=fixitnow_access_token

# Name of the cookie used to store the JWT refresh token
NEXT_PUBLIC_AUTH_REFRESH_COOKIE=fixitnow_refresh_token

# Name of the cookie used to store the current user's role (read by proxy.ts for role-based routing)
NEXT_PUBLIC_AUTH_ROLE_COOKIE=fixitnow_user_role

# Note: SSLCommerz success/cancel redirect URLs are configured on the
# backend (POST /payments/init/:bookingId controls where the gateway
# redirects back to) — no frontend env var is needed for this. The
# frontend's own routes are /payment/success and /payment/cancel.
